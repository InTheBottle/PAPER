{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "paper-plugin",
  "version-string": "2.2.4",
  "port-version": 0,
  "description": "The PAper Papyrus ExtendeR. Plugin to expose new functions and events to Skyrim's 'Papyrus' scripting language.",
  "license": "Apache-2.0",
  "supports": "windows & x64",
  "builtin-baseline": "ee12231b20c95013c6638d845d04c91559a1d1ff",
  "features": {
    "scripts": {
      "description": "Install Papyrus sources for this program to develop on top of it."
    },
    "scripts-dev": {
      "description": "Install Papyrus sources necessary to develop scripts for this plugin.",
      "dependencies": [
        "bethesda-skyrim-scripts",
        {
          "name": "skse",
          "default-features": false,
          "features": [
            "scripts"
          ]
        }
      ]
    },
    "plugin": {
      "description": "Build the SKSE plugin against the vendored CommonLibSSE-NG submodule.",
      "dependencies": [
        {
          "name": "directxmath",
          "version>=": "2025-04-03"
        },
        {
          "name": "directxtk",
          "version>=": "2025-10-27"
        },
        {
          "name": "fmt",
          "version>=": "12.1.0"
        },
        {
          "name": "nlohmann-json",
          "version>=": "3.12.0"
        },
        {
          "name": "rapidcsv",
          "version>=": "8.90"
        },
        {
          "name": "simpleini",
          "version>=": "4.25"
        },
        {
          "name": "spdlog",
          "version>=": "1.16.0"
        },
        {
          "name": "toml11",
          "version>=": "4.4.0"
        },
        {
          "name": "xbyak",
          "version>=": "7.28"
        }
      ]
    }
  },
  "default-features": [
    "scripts-dev",
    "plugin"
  ]
}
